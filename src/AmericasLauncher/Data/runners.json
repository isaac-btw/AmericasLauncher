[
  {
    "id": "xcl",
    "name": "XCL",
    "gitUrl": "https://github.com/xcl-dev/xcl.git",
    "dependencies": [
      {
        "name": "Git",
        "wingetId": "Git.Git",
        "check": "command:git"
      },
      {
        "name": "Visual Studio Build Tools (C++)",
        "wingetId": "Microsoft.VisualStudio.2022.BuildTools",
        "check": "vsbuildtools",
        "wingetOverride": "--wait --passive --norestart --add Microsoft.VisualStudio.Workload.VCTools --includeRecommended"
      },
      {
        "name": "Rust (rustup)",
        "wingetId": "Rustlang.Rustup",
        "check": "command:cargo"
      }
    ],
    "buildCommands": [
      "rustup toolchain install stable-x86_64-pc-windows-msvc --profile minimal",
      "cargo +stable-x86_64-pc-windows-msvc build --release --workspace"
    ],
    "exe": "target\\release\\xcl.exe",
    "launchArgs": "run \"{gameFolder}\"",
    "notes": "Best with Both"
  },
  {
    "id": "VIctory-Belobug",
    "name": "Belabug - VIctory Based",
    "gitUrl": "https://github.com/Belobug/VIctory-Belobug-AMD.git",
    "dependencies": [
      {
        "name": "Git",
        "wingetId": "Git.Git",
        "check": "command:git"
      },
      {
        "name": "Visual Studio Build Tools (C++)",
        "wingetId": "Microsoft.VisualStudio.2022.BuildTools",
        "check": "vsbuildtools",
        "wingetOverride": "--wait --passive --norestart --add Microsoft.VisualStudio.Workload.VCTools --includeRecommended"
      },
      {
        "name": "Rust (rustup)",
        "wingetId": "Rustlang.Rustup",
        "check": "command:cargo"
      }
    ],
    "buildCommands": [
      "rustup toolchain install stable-x86_64-pc-windows-msvc --profile minimal",
      "copy victory.example.toml victory.toml",
      "cargo +stable-x86_64-pc-windows-msvc build --release -p victory"
    ],
    "exe": "target\\release\\victory.exe",
    "preLaunchArgs": [
      "translate --pipelines \"{gameFolder}\\shaders.rpf\" \"{gameExe}\" \"{gameFolder}\\XboxBvhBuilder.dll\" \"{gameFolder}\\amd_fidelityfx_upscaler_xbox.dll\""
    ],
    "launchArgs": "run \"{gameExe}\" --execute",
    "notes": "Best with AMD"
  },
  {
    "id": "Dexnom",
    "name": "Dexnom - VIctory Based",
    "gitUrl": "https://github.com/DexNom/VIctory.git",
    "dependencies": [
      {
        "name": "Git",
